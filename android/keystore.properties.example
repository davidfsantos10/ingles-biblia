# Copie este arquivo para "keystore.properties" (mesma pasta, android/) e
# preencha com os valores reais do SEU keystore de release -- NUNCA cole
# senhas de verdade neste arquivo .example, e NUNCA envie keystore.properties
# pro git (já está no android/.gitignore).
#
# Veja o passo a passo completo de como gerar o keystore de release na
# conversa com o Claude, ou rode:
#   keytool -genkeypair -v -keystore /caminho/seguro/ingles-biblia-release.jks \
#     -alias ingles-biblia -keyalg RSA -keysize 2048 -validity 10000

storeFile=/caminho/absoluto/para/ingles-biblia-release.jks
storePassword=
keyAlias=ingles-biblia
keyPassword=
